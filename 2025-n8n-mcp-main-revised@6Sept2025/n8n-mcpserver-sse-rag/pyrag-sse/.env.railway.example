# ═══════════════════════════════════════════════════════════════
# Railway Deployment Environment Variables (TEMPLATE)
# ═══════════════════════════════════════════════════════════════
# นี่คือไฟล์ตัวอย่าง (ไม่มี API key จริง - ปลอดภัยที่จะ commit)
# คัดลอกค่าเหล่านี้ไปใส่ใน Railway → Service → Variables
# อย่าลืมแทนที่ OPENAI_API_KEY ด้วย key จริงของคุณ!
# ═══════════════════════════════════════════════════════════════

# ========================================
# Qdrant Vector Database Configuration
# ========================================
# ใช้ Railway internal DNS (ไม่ต้องแก้)
QDRANT_URL=http://qdrant:6333

# ========================================
# Embedding Provider Configuration
# ========================================
# ใช้ OpenAI เพราะรันบน cloud (ไม่ใช้ Ollama)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# ========================================
# OpenAI API Key
# ========================================
# ⚠️ สำคัญ: เปลี่ยนเป็น API Key ของคุณเอง!
# ไปที่: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# ========================================
# Server Configuration
# ========================================
# ไม่ต้องแก้ - Railway จะตั้งค่าให้อัตโนมัติ
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# ========================================
# Optional: Ollama Configuration
# ========================================
# ไม่ต้องใส่เพราะใช้ OpenAI แล้ว
# OLLAMA_URL=http://localhost:11434

# ═══════════════════════════════════════════════════════════════
# วิธีใส่ Variables ใน Railway:
# ═══════════════════════════════════════════════════════════════
# 1. เปิด Railway Dashboard
# 2. คลิกที่ MCP Server service
# 3. ไปที่ Tab "Variables"
# 4. คลิก "+ Add Variable"
# 5. คัดลอก variables ข้างต้นไปวาง (ทีละตัว)
# 6. คลิก "Deploy" (มุมล่างขวา)
# ═══════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════
# หมายเหตุสำคัญ:
# ═══════════════════════════════════════════════════════════════
# 1. ห้าม commit OPENAI_API_KEY ลง GitHub
# 2. ใส่ API Key ใน Railway Variables เท่านั้น
# 3. ตรวจสอบว่า QDRANT_URL ใช้ internal DNS (http://qdrant:6333)
# 4. PORT ต้องเป็น 8000 (ตรงกับ Dockerfile EXPOSE)
# ═══════════════════════════════════════════════════════════════